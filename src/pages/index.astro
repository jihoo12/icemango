---
import "../styles/global.css";

const stages = [
  { id: "01", temp: "-24°C", word: "FROZEN", sub: "Everything begins rigid." },
  { id: "02", temp: "04°C", word: "MELTING", sub: "Structure starts to surrender." },
  { id: "03", temp: "37°C", word: "COLLIDE", sub: "Cold meets something impossible." },
  { id: "04", temp: "72°C", word: "MANGO", sub: "Now we're getting somewhere." },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta
    name="description"
    content="ICE/MANGO — an experimental CSS-first experience."
  />
  <meta name="theme-color" content="#e9f7ff" />
  <title>ICE / MANGO — MELT THE WEB</title>
</head>

<body>
  <div class="grain" aria-hidden="true"></div>
  <div class="pointer" aria-hidden="true"></div>

  <header class="nav">
    <a href="#top" class="brand">ICE<span>/</span>MANGO</a>

    <div class="nav-status">
      <span class="status-dot"></span>
      <span>THERMAL SYSTEM ONLINE</span>
    </div>

    <a href="#melt" class="nav-jump">BEGIN MELT ↓</a>
  </header>

  <main id="top">
    <!-- ==================================================
         00 / FROZEN
    =================================================== -->

    <section class="ice">
      <div class="ice-grid" aria-hidden="true"></div>

      <div class="ice-meta">
        <span>[ PHASE 00 ]</span>
        <span>STATE: SOLID</span>
        <span>TEMP: −24°C</span>
      </div>

      <div class="ice-title">
        <span class="ice-title-top">ICE</span>

        <div class="ice-cut">
          <span>ICE</span>
        </div>

        <span class="ice-title-bottom">ICE</span>
      </div>

      <div class="ice-bottom">
        <p>
          THE WEB<br />
          BEFORE HEAT.
        </p>

        <div class="thermometer">
          <span>−24</span>
          <div class="thermometer-line">
            <i></i>
          </div>
          <span>72</span>
        </div>

        <p class="right">
          SCROLL<br />
          TO APPLY HEAT ↓
        </p>
      </div>
    </section>

    <!-- ==================================================
         01 / MELT
    =================================================== -->

    <section class="melt" id="melt">
      <div class="melt-sticky">
        <div class="melt-counter">
          <span>[ 01 ]</span>
          <span>MELTING POINT</span>
        </div>

        <div class="melt-word" aria-label="Melt">
          <span>M</span>
          <span>E</span>
          <span>L</span>
          <span>T</span>
        </div>

        <div class="drips" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>

        <div class="melt-temp">
          <span>−24°C</span>
          <strong>→</strong>
          <span>04°C</span>
        </div>
      </div>
    </section>

    <!-- ==================================================
         TRANSITION
    =================================================== -->

    <section class="transition">
      <div class="transition-copy">
        <p>RIGID</p>
        <p>BECOMES</p>
        <p class="liquid">LIQUID.</p>
      </div>

      <aside>
        CSS DOESN'T NEED TO<br />
        SIT STILL.
      </aside>
    </section>

    <!-- ==================================================
         02 / COLLISION
    =================================================== -->

    <section class="collision">
      <div class="collision-sticky">
        <div class="collision-meta">
          <span>[ PHASE 02 ]</span>
          <span>UNSTABLE</span>
        </div>

        <div class="collision-ice" aria-hidden="true">
          <span>ICE</span>
        </div>

        <div class="collision-mango" aria-hidden="true">
          <span>MANGO</span>
        </div>

        <div class="collision-center">
          <span>+</span>
        </div>

        <p class="collision-caption">
          TWO TEMPERATURES.<br />
          ONE VIEWPORT.
        </p>
      </div>
    </section>

    <!-- ==================================================
         EXPLOSION
    =================================================== -->

    <section class="explosion">
      <div class="explosion-ring ring-1"></div>
      <div class="explosion-ring ring-2"></div>
      <div class="explosion-ring ring-3"></div>

      <p class="boom">BOOM</p>

      <div class="explosion-meta">
        <span>37°C</span>
        <span>THERMAL COLLISION</span>
        <span>37°C</span>
      </div>
    </section>

    <!-- ==================================================
         03 / THERMAL INDEX
    =================================================== -->

    <section class="index">
      <header class="index-head">
        <span>[ THERMAL INDEX ]</span>

        <p>
          FOUR STATES.<br />
          ZERO FRAMEWORKS*.
        </p>

        <small>*except Astro being quietly useful</small>
      </header>

      <div class="index-list">
        {
          stages.map((stage) => (
            <article class="index-row">
              <span class="index-id">{stage.id}</span>
              <span class="index-temp">{stage.temp}</span>

              <div class="index-name">
                <span>{stage.word}</span>
              </div>

              <p>{stage.sub}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ==================================================
         04 / HORIZONTAL TYPOGRAPHY
    =================================================== -->

    <section class="horizontal">
      <div class="horizontal-sticky">
        <div class="horizontal-track">
          <span>COLD</span>
          <i>→</i>
          <span>MELT</span>
          <i>→</i>
          <span>HOT</span>
          <i>→</i>
          <span>MANGO</span>
        </div>

        <div class="horizontal-bottom">
          <span>SCROLL = TEMPERATURE</span>
          <span>ICE/MANGO THERMAL LAB</span>
        </div>
      </div>
    </section>

    <!-- ==================================================
         05 / MANGO
    =================================================== -->

    <section class="mango">
      <div class="sun sun-a" aria-hidden="true"></div>
      <div class="sun sun-b" aria-hidden="true"></div>

      <div class="mango-meta">
        <span>[ FINAL PHASE ]</span>
        <span>STATE: DELICIOUS</span>
        <span>TEMP: 72°C</span>
      </div>

      <div class="mango-title">
        <span>MAN</span>
        <span>GO</span>
      </div>

      <div class="mango-orbit" aria-hidden="true">
        <div class="mango-fruit">
          <span>72°</span>
        </div>
      </div>

      <div class="mango-foot">
        <p>
          WE STARTED<br />
          WITH ICE.
        </p>

        <p class="mango-message">
          SOMEWHERE ALONG THE WAY<br />
          THE BROWSER CAUGHT FIRE.
        </p>
      </div>
    </section>

    <!-- ==================================================
         MANIFESTO
    =================================================== -->

    <section class="manifesto">
      <span class="manifesto-label">[ CSS MANIFESTO ]</span>

      <div class="manifesto-lines">
        <p>DON'T DECORATE</p>
        <p>THE <em>PAGE.</em></p>
        <p>MAKE THE PAGE</p>
        <p><strong>THE THING.</strong></p>
      </div>

      <div class="manifesto-small">
        <p>
          NO THREE.JS.<br />
          NO CANVAS.<br />
          NO PARTICLE ENGINE.
        </p>

        <p>
          JUST TYPE, COLOR, LAYOUT,<br />
          THE SCROLLBAR AND A<br />
          SLIGHTLY UNHEALTHY AMOUNT<br />
          OF CSS.
        </p>
      </div>
    </section>

    <!-- ==================================================
         FINALE
    =================================================== -->

    <section class="finale">
      <div class="finale-noise" aria-hidden="true"></div>

      <div class="finale-meta">
        <span>ICE/MANGO®</span>
        <span>CSS THERMAL LABORATORY</span>
        <span>2026</span>
      </div>

      <h1>
        MELT
        <span>THE</span>
        WEB.
      </h1>

      <div class="finale-bottom">
        <a href="#top">FREEZE AGAIN ↑</a>

        <div class="finale-disc">
          <span>ICE / MANGO / ICE / MANGO /</span>
        </div>

        <p>
          MADE WITH<br />
          ASTRO + CSS
        </p>
      </div>
    </section>
  </main>

  <script>
    const root = document.documentElement;

    window.addEventListener(
      "pointermove",
      (event) => {
        root.style.setProperty("--mx", `${event.clientX}px`);
        root.style.setProperty("--my", `${event.clientY}px`);

        const x = event.clientX / window.innerWidth - 0.5;
        const y = event.clientY / window.innerHeight - 0.5;

        root.style.setProperty("--rx", `${y * -8}deg`);
        root.style.setProperty("--ry", `${x * 8}deg`);
      },
      { passive: true },
    );
  </script>
</body>
</html>